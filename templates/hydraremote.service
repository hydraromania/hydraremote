[Unit]
Description=HydraREMOTE Rendezvous & PWA Server
After=network.target

[Service]
Type=simple
User=hydra
WorkingDirectory=/home/hydra/hydraremote/server
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=5
Environment=PORT=4420
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
